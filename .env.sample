DB_HOST=localhost
DB_NAME=mytube
DB_USER=mytube
DB_PASS=changeme

# Public base URL of the application, used for links in emails
SITE_URL=https://example.com/videos/

# production (default) or development
APP_ENV=production

# Time zone for displayed dates
APP_TIMEZONE=Europe/Brussels

# Reverse proxies allowed to set X-Forwarded-For (comma-separated IPs), so that
# login throttling sees the real client address. Leave empty without a proxy.
TRUSTED_PROXIES=

# Outgoing mail (account verification, password reset)
# SMTP_SECURE: empty (plain SMTP), "tls" (STARTTLS) or "ssl" (SMTPS)
SMTP_HOST=localhost
SMTP_PORT=25
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=
MAIL_FROM=noreply@example.com
MAIL_FROM_NAME=MyTube

# Invisible reCAPTCHA (score-based key) on login, registration and password reset.
# How to obtain these values: docs/recaptcha.md. Leave RECAPTCHA_SITE_KEY empty to disable.
#   RECAPTCHA_MODE=assessment : CreateAssessment API (recommended), needs PROJECT_ID + API_KEY
#   RECAPTCHA_MODE=siteverify : legacy siteverify endpoint, needs SECRET_KEY
RECAPTCHA_SITE_KEY=
RECAPTCHA_MODE=assessment
RECAPTCHA_PROJECT_ID=
RECAPTCHA_API_KEY=
RECAPTCHA_SECRET_KEY=
# Requests scoring below this (0.0 = bot … 1.0 = human) are rejected
RECAPTCHA_MIN_SCORE=0.5

# Footer and branding
FOOTER_COPYRIGHT="© Your Name 2024-2025"
BMC_ENABLED=true
BMC_SLUG=yourslug
BMC_BUTTON_TEXT="Buy me a coffee"
