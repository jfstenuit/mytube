DB_HOST=localhost
DB_NAME=mytube
DB_USER=mytube
DB_PASS=changeme

SITE_URL=https://example.com

# production (default) or development
APP_ENV=production

# Reverse proxies allowed to set X-Forwarded-For (comma-separated IPs), so that
# login throttling sees the real client address. Leave empty without a proxy.
TRUSTED_PROXIES=

# Outgoing mail (account verification, password reset)
# SMTP_SECURE: empty (plain SMTP), "tls" (STARTTLS) or "ssl" (SMTPS)
SMTP_HOST=localhost
SMTP_PORT=25
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=
MAIL_FROM=noreply@example.com
MAIL_FROM_NAME=MyTube

# Footer and branding
FOOTER_COPYRIGHT="© Your Name 2024-2025"
BMC_ENABLED=true
BMC_SLUG=yourslug
BMC_BUTTON_TEXT="Buy me a coffee"
