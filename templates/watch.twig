{% extends 'base.twig' %}

{% block head %}
  {% for key, value in og %}
  <meta property="og:{{ key }}" content="{{ value|e('html_attr') }}" />
  {% endfor %}

  {% include 'partials/videojs-includes.twig' %}
  {% include 'partials/videojs-plugins.twig' %}

  <link href="{{ og.image }}" rel="image_src">
  <link rel="alternate" type="application/json+oembed" href="{{ og.url|replace({'watch': 'oembed'}) }}" title="oEmbed JSON">
  <link rel="alternate" type="text/xml+oembed" href="{{ og.url|replace({'watch': 'oembed'}) }}&format=xml" title="oEmbed XML">

  <script defer src="{{ asset('assets/js/mytube.js') }}"></script>
  <script defer src="{{ asset('assets/js/views.js') }}"></script>
{% endblock %}

{% block title %}{{ video.title|e }}{% endblock %}

{% block content %}
  <main>
  <section class="video-section">
    <div class="video-container">
      <div class="video-wrapper" style="position: relative; width: 100%; padding-top: {{ (video.aspect_ratio * 100) }}%;">
        <video id="video-player" class="video-js" controls preload="auto"
          style="position: absolute; top: 0; left: 0; width: 100%; height: 100%;"
          data-src="{{ video.encoded_video }}"
          data-thumb="{{ video.encoded_thumbnail }}"
          {% if view_token is defined %}data-video-id="{{ video.id }}" data-view-token="{{ view_token }}" data-view-threshold="{{ view_threshold }}"{% endif %}>
        </video>
      </div>
    </div>
    <div class="video-meta">
      <h2>{{ video.title|e }}</h2>
      <div class="video-actions">
        <span class="view-count">{{ video.view_count|number_format(0, ',', ' ') }} vue{{ video.view_count > 1 ? 's' }}</span>
        <div class="actions">
          {% set like_label = like_count|number_format(0, ',', ' ') %}
          {% if engage_state == 'member' %}
          <form method="post" action="like" class="like-form">
            <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
            <input type="hidden" name="v" value="{{ video.id }}">
            <button type="submit" class="like-btn" aria-pressed="{{ liked ? 'true' : 'false' }}"
                    title="{{ liked ? 'Je n\'aime plus' : 'J\'aime' }}">
              <span class="material-icons" aria-hidden="true">{{ liked ? 'thumb_up' : 'thumb_up_off_alt' }}</span>
              <span class="like-count">{{ like_label }}</span>
            </button>
          </form>
          {% else %}
          <span class="like-btn is-disabled"
                title="{{ engage_state == 'anonymous' ? 'Connectez-vous pour aimer cette vidéo' : 'Réservé aux membres ayant accès à cette collection' }}">
            <span class="material-icons" aria-hidden="true">thumb_up_off_alt</span>
            <span class="like-count">{{ like_label }}</span>
          </span>
          {% endif %}
          <button id="share-btn" class="material-icons" title="Partager">share</button>
          <button id="embed-btn" class="material-icons" title="Intégrer">code</button>
        </div>
      </div>
    </div>

    <div class="video-description">
      {{ video.description }}
    </div>

    <section class="comments" id="comments">
      <h3>{{ comments|length }} commentaire{{ comments|length > 1 ? 's' }}</h3>

      {% if engage_state == 'member' %}
      <form method="post" action="comment" class="comment-form">
        <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
        <input type="hidden" name="v" value="{{ video.id }}">
        <label for="comment-text" class="visually-hidden">Votre commentaire</label>
        <textarea id="comment-text" name="comment" rows="3" maxlength="{{ comment_max }}" required
                  placeholder="Ajouter un commentaire…">{{ comment_draft }}</textarea>
        <button type="submit" class="btn btn-primary btn-small">Publier</button>
      </form>
      {% elseif engage_state == 'anonymous' %}
      <p class="muted"><a href="login?return={{ current_url|url_encode }}">Connectez-vous</a> pour commenter.</p>
      {% else %}
      <p class="muted">Les commentaires sont réservés aux membres ayant accès à cette collection.</p>
      {% endif %}

      {% for comment in comments %}
      <article class="comment">
        <div class="comment-head">
          <strong>{{ comment.author }}</strong>
          <time class="muted small" datetime="{{ comment.posted_at|date('c') }}">{{ comment.posted_at|date('d/m/Y à H:i') }}</time>
          {% if current_user and (comment.user_id == current_user.id or is_admin) %}
          <form method="post" action="comment/delete" class="comment-delete" onsubmit="return confirm('Supprimer ce commentaire ?');">
            <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
            <input type="hidden" name="id" value="{{ comment.id }}">
            <button type="submit" class="material-icons" title="Supprimer">delete</button>
          </form>
          {% endif %}
        </div>
        <p>{{ comment.comment|nl2br }}</p>
      </article>
      {% endfor %}
    </section>

  </section>

  <aside class="sidebar">
    <div class="section collection-section">
      <div class="collection-header">
        <div class="collection-title">
          <span class="collection-label">Collection</span>
          <h3>{{ collection_nav.current.name }}</h3>
        </div>
        {% if collection_nav.others %}
        {# Other collections the viewer can see; each opens its most recently added video #}
        <details class="collection-switcher">
          <summary>Autres collections <span class="material-icons" aria-hidden="true">expand_more</span></summary>
          <ul>
            {% for other in collection_nav.others %}
            <li><a href="watch?v={{ other.latest_video|url_encode }}">{{ other.name }}</a></li>
            {% endfor %}
          </ul>
        </details>
        {% endif %}
      </div>
      <div class="related-videos">
{% for altvid in seealso %}
        <a href="watch?v={{ altvid.id|url_encode }}" class="video-card">
          <img src="thumbs/{{ altvid.id|url_encode }}.jpg" alt="">
          <span>{{ altvid.title|e }}</span>
        </a>
{% else %}
        <p class="muted small">Aucune autre vidéo dans cette collection.</p>
{% endfor %}
      </div>
    </div>
    {% if bmc_enabled and bmc_slug %}
    <div class="section">
      <h3>Soutenez mon travail</h3>

      <script src="https://cdnjs.buymeacoffee.com/1.0.0/button.prod.min.js"
        data-name="bmc-button" data-slug="{{ bmc_slug|e('html_attr') }}" data-color="#FFDD00"
        data-emoji="" data-font="Cookie" data-text="{{ bmc_button_text|e('html_attr') }}"
        data-outline-color="#000000" data-font-color="#000000"
        data-coffee-color="#ffffff"></script>
    </div>
    {% endif %}
  </aside>
  </main>
{% endblock %}

{% block body_end %}
<div id="embed-modal" class="modal" hidden>
  <div class="modal-backdrop" data-close></div>
  <div class="modal-content" role="dialog" aria-modal="true">
    <h3>Intégrer cette vidéo</h3>
    <textarea id="embed-code" readonly>
&lt;div style="position: relative; width: 100%; aspect-ratio: 16 / 9; overflow: hidden; background: #000;"&gt;
    &lt;iframe
        src="{{ og.url|replace({'watch': 'embed'}) }}"
        style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; border: 0;"
        frameborder="0"
        allowfullscreen&gt;
    &lt;/iframe&gt;
&lt;/div&gt;
    </textarea>
    <button id="copy-embed">Copier</button>
    <button data-close>Fermer</button>
  </div>
</div>
{% endblock %}
