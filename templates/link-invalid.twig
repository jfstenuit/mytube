{% extends 'base.twig' %}

{% block title %}Lien invalide – MyTube{% endblock %}

{% block content %}
  <main class="page-narrow">
    <section class="card">
      <h2>Lien invalide ou expiré</h2>
      <p>Ce lien n'est plus valable : il a peut-être déjà été utilisé, ou il a expiré.</p>
      {% if kind == 'verify' %}
      <p><a href="resend-verification">Recevoir un nouveau lien de confirmation</a></p>
      {% elseif kind == 'reset' %}
      <p><a href="forgot-password">Demander un nouveau lien de réinitialisation</a></p>
      {% else %}
      <p><a href="account">Refaire la demande depuis votre compte</a></p>
      {% endif %}
    </section>
  </main>
{% endblock %}
