{% extends 'base.twig' %}

{% block title %}Mon compte – MyTube{% endblock %}

{% block content %}
  <main class="page-narrow">
    <section class="card" id="profile">
      <h2>Mon profil</h2>
      <form method="post" action="account" class="form">
        <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
        <input type="hidden" name="form" value="profile">

        <label for="profile-username">Nom d'utilisateur</label>
        <input id="profile-username" type="text" value="{{ current_user.username }}" readonly>

        <label for="profile-display-name">Nom affiché</label>
        <input id="profile-display-name" name="display_name" type="text" value="{{ current_user.display_name }}"
               maxlength="255" autocomplete="name" required>

        <label for="profile-email">Adresse e-mail</label>
        <input id="profile-email" name="email" type="email" value="{{ current_user.email }}"
               maxlength="255" autocomplete="email" required>

        {% if current_user.groups %}
        <p class="form-hint">Groupes : {{ current_user.groups|join(', ') }}</p>
        {% endif %}

        <button type="submit" class="btn btn-primary">Enregistrer</button>
      </form>
    </section>

    <section class="card" id="password">
      <h2>Changer le mot de passe</h2>
      <form method="post" action="account" class="form">
        <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
        <input type="hidden" name="form" value="password">
        {# Hidden username helps password managers associate the new password #}
        <input type="text" name="username" value="{{ current_user.username }}" autocomplete="username" hidden>

        <label for="password-current">Mot de passe actuel</label>
        <input id="password-current" name="current_password" type="password" autocomplete="current-password" required>

        <label for="password-new">Nouveau mot de passe</label>
        <input id="password-new" name="new_password" type="password" autocomplete="new-password" minlength="10" required>

        <label for="password-confirm">Confirmer le nouveau mot de passe</label>
        <input id="password-confirm" name="confirm_password" type="password" autocomplete="new-password" minlength="10" required>

        <p class="form-hint">Au moins 10 caractères. Vos autres sessions seront déconnectées.</p>

        <button type="submit" class="btn btn-primary">Changer le mot de passe</button>
      </form>
    </section>
  </main>
{% endblock %}
