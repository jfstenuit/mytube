{% extends 'base.twig' %}

{% block head %}{% include 'partials/recaptcha-head.twig' %}{% endblock %}

{% block title %}Mot de passe oublié – MyTube{% endblock %}

{% block content %}
  <main class="page-narrow">
    <section class="card">
      <h2>Mot de passe oublié</h2>

      {% if error %}<div class="alert alert-error" role="alert">{{ error }}</div>{% endif %}

      <p>Indiquez l'adresse e-mail de votre compte : vous recevrez un lien pour choisir un nouveau mot de passe.</p>

      <form method="post" action="forgot-password" class="form" data-recaptcha-action="forgot_password">
        <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">

        <label for="forgot-email">Adresse e-mail</label>
        <input id="forgot-email" name="email" type="email" value="{{ email }}" maxlength="255"
               autocomplete="email" required autofocus>

        {% include 'partials/recaptcha-field.twig' %}

        <button type="submit" class="btn btn-primary">Envoyer le lien</button>
      </form>
    </section>

    <p class="page-links"><a href="login">Retour à la connexion</a></p>
  </main>
{% endblock %}
